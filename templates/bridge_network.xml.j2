<network>
  <name>{{ rhel_kvm_bridge_network_name }}</name>
  <forward mode='nat'/>
  <bridge name='{{ rhel_kvm_bridge_device }}' stp='on' delay='0'/>
  <ip address='{{ rhel_kvm_bridge_ip }}' netmask='{{ rhel_kvm_bridge_netmask }}'>
    <dhcp>
      <range start='{{ rhel_kvm_bridge_dhcp_start }}' end='{{ rhel_kvm_bridge_dhcp_end }}'/>
    </dhcp>
  </ip>
</network>

